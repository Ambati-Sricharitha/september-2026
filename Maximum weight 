from bisect import bisect_left

class Solution:
    def maximumWeight(self, intervals):
        a = sorted([(r, l, w, i) for i, (l, r, w) in enumerate(intervals)])
        ends = [x[0] for x in a]
        n = len(a)

        # dp[i][k] = (maximum score, lexicographically smallest indices)
        dp = [[(0, ()) for _ in range(5)] for _ in range(n + 1)]

        for i in range(1, n + 1):
            r, l, w, idx = a[i - 1]

            # Previous interval must have end < l
            p = bisect_left(ends, l, 0, i - 1)

            for k in range(1, 5):
                # Don't take current interval
                best = dp[i - 1][k]

                # Take current interval
                score, ids = dp[p][k - 1]
                candidate = (score + w, tuple(sorted(ids + (idx,))))

                if candidate[0] > best[0] or (
                    candidate[0] == best[0] and candidate[1] < best[1]
                ):
                    best = candidate

                dp[i][k] = best

        return list(dp[n][4][1])