class Solution:
    def resultArray(self, nums, k):
        ans = [0] * k
        dp = [0] * k

        for num in nums:
            new = [0] * k
            r = num % k

            # Start a new subarray
            new[r] += 1

            # Extend previous subarrays
            for old in range(k):
                if dp[old]:
                    new[(old * r) % k] += dp[old]

            dp = new

            # Add all subarrays ending here
            for r in range(k):
                ans[r] += dp[r]

        return ans