class Solution:
    def hasValidPath(self, grid):
        m, n = len(grid), len(grid[0])

        # Total path length must be even
        if (m + n - 1) % 2 != 0:
            return False

        # First and last characters must be '(' and ')'
        if grid[0][0] == ')' or grid[m-1][n-1] == '(':
            return False

        dp = [[set() for _ in range(n)] for _ in range(m)]

        dp[0][0].add(1)

        for i in range(m):
            for j in range(n):
                if i == 0 and j == 0:
                    continue

                change = 1 if grid[i][j] == '(' else -1

                if i > 0:
                    for bal in dp[i-1][j]:
                        if bal + change >= 0:
                            dp[i][j].add(bal + change)

                if j > 0:
                    for bal in dp[i][j-1]:
                        if bal + change >= 0:
                            dp[i][j].add(bal + change)

        return 0 in dp[m-1][n-1]